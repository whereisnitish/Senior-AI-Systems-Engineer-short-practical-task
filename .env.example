# Copy to .env for LOCAL DEVELOPMENT ONLY. A .env file is NOT a vault:
# it must never contain Instagram passwords, backup codes, proxy credentials or tokens.
# Platform secrets live in the company vault and are referenced as vault://... only.

APP_ENV=development
# Required (min 32 chars). Generate with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
APP_SECRET_KEY=
DATABASE_URL=sqlite:///./data/instagram_ops.db
LOG_DIR=logs
REPORTS_DIR=reports
LOG_LEVEL=INFO
HOST=127.0.0.1
PORT=8000
PUBLIC_BASE_URL=http://127.0.0.1:8000
# Comma-separated. Empty = CORS disabled (recommended).
CORS_ALLOWED_ORIGINS=
# Required in production, e.g. ops.company.example
TRUSTED_HOSTS=
SCHEDULER_ENABLED=true
# Failed bearer-token / sign-in attempts per client address per window before answering 429.
AUTH_MAX_FAILED_ATTEMPTS=10
AUTH_FAILURE_WINDOW_SECONDS=900

# --- Vault --------------------------------------------------------------------
# reference_only (default; safe for the live run: the app never reads/writes secrets)
# dev_memory     (development/test only; synthetic SYNTHETIC-* values only)
# hashicorp_kv2  (HashiCorp Vault KV v2; token read from a file)
VAULT_BACKEND=reference_only
VAULT_REF_SCHEMES=vault,op,bw,aws-sm,azure-kv,gcp-sm
# DEV_VAULT_FILE=data/dev_vault.synthetic.json
# VAULT_ADDR=https://vault.company.example:8200
# VAULT_KV_MOUNT=secret
# VAULT_TOKEN_FILE=/run/secrets/vault_token
# VAULT_NAMESPACE=

# Approved company email domains (recovery-email checks use these). Domains the COMPANY controls only:
# consumer domains such as gmail.com are refused. Record a personal mailbox as personal_provider_substitute.
COMPANY_EMAIL_DOMAINS=company.example

# --- Meta (read-only verification; leave disabled until access is confirmed) -----
META_INTEGRATION=disabled
# META_GRAPH_API_VERSION=vXX.0
# META_BUSINESS_ID=
# META_ACCESS_TOKEN_VAULT_REF=vault://ops/meta/read-only-token

# --- Notifications ----------------------------------------------------------------
NOTIFICATION_BACKEND=none
# SMTP_HOST=smtp.company.example
# SMTP_PORT=587
# SMTP_USERNAME=ops-notifications
# SMTP_PASSWORD_VAULT_REF=vault://ops/smtp/password
# SMTP_FROM=ops-notifications@company.example

# --- Human tasks -----------------------------------------------------------------
REMINDER_INTERVAL_HOURS=24
OVERDUE_REMINDER_INTERVAL_HOURS=12
MAX_REMINDERS=6
ESCALATION_GRACE_HOURS=0
ESCALATION_REPEAT_HOURS=24
MAX_ESCALATIONS=2

# --- Audit -------------------------------------------------------------------------
ACCESS_STALE_DAYS=30
AUDIT_WEEKLY_DAY=mon
AUDIT_WEEKLY_HOUR_UTC=9

# --- Proxies -----------------------------------------------------------------------
# Approved proxy list (no credentials in the file; credential_ref points to the vault)
# PROXY_CONFIG_FILE=config/proxies.json
# Neutral endpoint(s) the company approved for health checks - never a social platform.
PROXY_HEALTHCHECK_ALLOWED_URLS=
# PROXY_HEALTHCHECK_DEFAULT_URL=
PROXY_CONNECT_TIMEOUT_SECONDS=3
PROXY_READ_TIMEOUT_SECONDS=5
PROXY_MAX_ATTEMPTS=3
PROXY_BACKOFF_BASE_SECONDS=0.5
PROXY_BACKOFF_MAX_SECONDS=8
PROXY_UNHEALTHY_AFTER_FAILED_CHECKS=1
PROXY_COOLDOWN_SECONDS=300
PROXY_MAX_FAILOVERS_PER_SESSION=2
PROXY_HEALTHCHECK_INTERVAL_MINUTES=10
